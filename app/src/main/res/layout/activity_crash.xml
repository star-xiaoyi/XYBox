<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/crash_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 一眼能看到的重点：异常类型、消息、第一条落在本项目代码里的栈帧 -->
    <TextView
        android:id="@+id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/shape_settings_card"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="12sp"
        tools:text="NullPointerException\nAttempt to invoke virtual method…" />

    <TextView
        android:id="@+id/env"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        tools:text="0.2.2 · HUAWEI BKY-W10 · Android 12 (31)" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/shape_settings_card"
        android:padding="12dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/trace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="11sp"
            tools:text="java.lang.NullPointerException\n\tat com.fongmi…" />

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/saved"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="已保存到 /storage/…/crash/crash-20260821-005131.txt"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/details"
            style="@style/DialogTextButton"
            android:text="@string/crash_copy" />

        <TextView
            android:id="@+id/restart"
            style="@style/DialogTextButton"
            android:layout_marginStart="4dp"
            android:text="@string/crash_restart"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
