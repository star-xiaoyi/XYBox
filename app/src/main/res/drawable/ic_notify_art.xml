<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏用的图标。刻意不复用 @mipmap/ic_launcher：
  那个名字下有两份资源，mipmap-anydpi-v26 的自适应图标走 launcher_background（黑底），
  而 mipmap-<density>/ic_launcher.webp 是传统栅格图、白底是烤进图片里的。
  取到哪一份由系统的资源匹配决定，通知栏就是这么拿到白底的。
  这里按自适应图标同样的构成自己画一遍：白色背景 + 黑色 XY 标志，保证两处永远一致。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
