<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/shape_icon_circle"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/setting_operation"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- 播放手势卡片 -->
            <LinearLayout style="@style/SettingsCard">

                <LinearLayout
                    android:id="@+id/gestureDoubleTapPlay"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/player_gesture_double_tap_play" />

                    <com.fongmi.android.tv.ui.custom.CustomSwitch
                        android:id="@+id/gestureDoubleTapPlaySwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/gestureDoubleTapSeek"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/player_gesture_double_tap_seek" />

                    <com.fongmi.android.tv.ui.custom.CustomSwitch
                        android:id="@+id/gestureDoubleTapSeekSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:id="@+id/gestureSeekSecondsDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/gestureSeekSeconds"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/player_gesture_seek_seconds" />

                    <TextView
                        android:id="@+id/gestureSeekSecondsText"
                        style="@style/SettingsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="10 秒" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/gestureBrightness"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/player_gesture_brightness" />

                    <com.fongmi.android.tv.ui.custom.CustomSwitch
                        android:id="@+id/gestureBrightnessSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/gestureVolume"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/player_gesture_volume" />

                    <com.fongmi.android.tv.ui.custom.CustomSwitch
                        android:id="@+id/gestureVolumeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/gestureProgress"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/player_gesture_progress" />

                    <com.fongmi.android.tv.ui.custom.CustomSwitch
                        android:id="@+id/gestureProgressSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/gestureEpisodePort"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/player_gesture_episode_port" />

                    <com.fongmi.android.tv.ui.custom.CustomSwitch
                        android:id="@+id/gestureEpisodePortSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/gestureEpisodeLand"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/player_gesture_episode_land" />

                    <com.fongmi.android.tv.ui.custom.CustomSwitch
                        android:id="@+id/gestureEpisodeLandSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
