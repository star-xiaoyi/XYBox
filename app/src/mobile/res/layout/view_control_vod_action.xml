<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:paddingStart="0dp"
    android:paddingEnd="8dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/player"
            style="@style/Control.Action"
            android:text="@string/play_exo" />

        <TextView
            android:id="@+id/scale"
            style="@style/Control.Action"
            tools:text="縮放" />

        <TextView
            android:id="@+id/speed"
            style="@style/Control.Action"
            tools:text="速度" />

        <TextView
            android:id="@+id/reset"
            style="@style/Control.Action"
            android:textColor="@color/text"
            tools:text="刷新" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/text"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_action_background"
            android:contentDescription="@string/play_track_text"
            android:padding="8dp"
            android:src="@drawable/ic_action_subtitle"
            android:tag="3"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/audio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_action_background"
            android:contentDescription="@string/play_track_audio"
            android:padding="8dp"
            android:src="@drawable/ic_control_audio"
            android:tag="1"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/video"
            style="@style/Control.Action"
            android:tag="2"
            android:text="@string/quality_auto"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/opening"
            style="@style/Control.Action"
            tools:text="片頭" />

        <TextView
            android:id="@+id/ending"
            style="@style/Control.Action"
            tools:text="片尾" />

        <ImageView
            android:id="@+id/danmaku"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_action_background"
            android:contentDescription="@string/danmaku_settings"
            android:padding="8dp"
            android:src="@drawable/ic_control_danmaku_settings"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/episodes"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_action_background"
            android:contentDescription="@string/detail_episode"
            android:padding="8dp"
            android:src="@drawable/ic_action_list" />

        <ImageView
            android:id="@+id/exit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_action_background"
            android:contentDescription="@string/play_exit_full"
            android:padding="8dp"
            android:src="@drawable/ic_control_exit_full"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</HorizontalScrollView>
