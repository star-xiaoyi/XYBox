<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_center_dialog"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="发现新版本 0.1.3" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="1. 修复 WebDAV 同步\n2. 优化设置页配色" />

    </androidx.core.widget.NestedScrollView>

    <!-- 下载进度：点更新后就地展开，不再另开弹窗 -->
    <LinearLayout
        android:id="@+id/progressGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="@color/surface_secondary"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="正在下载 42%" />

        <TextView
            android:id="@+id/cancel"
            style="@style/DialogTextButton"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="@string/dialog_negative" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/negative"
            style="@style/DialogTextButton"
            android:text="@string/dialog_negative" />

        <TextView
            android:id="@+id/positive"
            style="@style/DialogTextButton"
            android:layout_marginStart="4dp"
            android:text="@string/update_confirm"
            android:textColor="@color/accent_blue"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
