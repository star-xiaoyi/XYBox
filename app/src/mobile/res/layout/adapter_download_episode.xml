<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_margin="4dp"
    android:background="@drawable/selector_download_episode_bg"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:singleLine="true"
        android:textColor="@color/selector_download_episode_text"
        android:textSize="14sp"
        tools:text="第十二集 风起云涌" />

    <ImageView
        android:id="@+id/playing"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="7dp"
        android:contentDescription="@string/download_current_episode"
        android:src="@drawable/ic_episode_playing"
        android:tint="?attr/colorPrimary"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/done"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="7dp"
        android:contentDescription="@string/download_state_done"
        android:src="@drawable/ic_episode_cached"
        android:tint="@color/selector_download_episode_text"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:background="@drawable/shape_download_episode_badge"
        android:ellipsize="end"
        android:maxWidth="48dp"
        android:paddingStart="4dp"
        android:paddingTop="1dp"
        android:paddingEnd="4dp"
        android:paddingBottom="1dp"
        android:singleLine="true"
        android:textColor="@color/selector_download_episode_text"
        android:textSize="9sp"
        android:visibility="gone"
        tools:text="42%"
        tools:visibility="visible" />

</FrameLayout>
