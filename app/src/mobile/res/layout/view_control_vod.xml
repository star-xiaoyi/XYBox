<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_10">

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/back"
            style="@style/Control.VodIcon.Borderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_control_back"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:includeFontPadding="false"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="15sp"
                tools:text="慶餘年第一季：第一集" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/topRight"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/timeGroup"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="4dp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    tools:text="21:30" />

                <ImageView
                    android:id="@+id/charging_indicator"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_charging_bolt"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/battery_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingEnd="4dp"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:text="85%"
                    tools:visibility="visible" />

            </LinearLayout>

            <ImageView
                android:id="@+id/cast"
                style="@style/Control.VodIcon.Top"
                android:contentDescription="@string/cast_channel"
                android:src="@drawable/ic_control_cast" />

            <ImageView
                android:id="@+id/info"
                style="@style/Control.VodIcon.Top"
                android:layout_marginStart="2dp"
                android:contentDescription="@string/play_info"
                android:src="@drawable/ic_control_info" />

            <ImageView
                android:id="@+id/keep"
                style="@style/Control.VodIcon.Top"
                android:layout_marginStart="2dp"
                android:contentDescription="@string/keep"
                android:src="@drawable/ic_control_keep_off" />

            <ImageView
                android:id="@+id/pip"
                style="@style/Control.VodIcon.Top"
                android:layout_marginStart="2dp"
                android:contentDescription="@string/play_pip"
                android:padding="6dp"
                android:src="@drawable/ic_control_pip"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/player_more"
                style="@style/Control.VodIcon.Top"
                android:layout_marginStart="-3dp"
                android:contentDescription="@string/play_more"
                android:src="@drawable/ic_control_more" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/danmaku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/danmaku_toggle"
            android:padding="8dp"
            android:src="@drawable/ic_control_danmaku_on" />

    </LinearLayout>

    <include
        android:id="@+id/right"
        layout="@layout/view_control_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp" />

    <!--
      拖动进度条时的画面预览，压在进度条正上方。
      放在根布局而不是 bottom 里：一来不挤动进度条和动作条的布局流，
      二来它必须常驻 VISIBLE（只用 alpha 控制显隐）——GONE 或 INVISIBLE 的
      TextureView 不会创建 SurfaceTexture，ExoPlayer 拿不到输出面就不会解码，
      预热就成了摆设，每次拖动都要重新建面、建连接、再解码。
    -->
    <FrameLayout
        android:id="@+id/previewFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:alpha="0">

        <FrameLayout
            android:id="@+id/previewBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_preview"
            android:foregroundGravity="center">

            <TextureView
                android:id="@+id/previewVideo"
                android:layout_width="160dp"
                android:layout_height="90dp" />

            <!-- 已经显示过的预览帧覆盖在播放器表面上，回拖命中内存缓存时立即出现。 -->
            <ImageView
                android:id="@+id/previewImage"
                android:layout_width="160dp"
                android:layout_height="90dp"
                android:scaleType="fitXY"
                android:visibility="gone" />

        </FrameLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/parse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="5"
            tools:listitem="@layout/adapter_parse_dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <com.fongmi.android.tv.ui.custom.CustomSeekView
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/full"
                style="@style/Control.VodIcon.Borderless"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/play_enter_full"
                android:src="@drawable/ic_control_full" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/center"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/prev"
                    style="@style/Control.VodIcon.Action"
                    android:contentDescription="@string/play_prev"
                    android:src="@drawable/ic_control_previous"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/play"
                    style="@style/Control.VodIcon.Action"
                    android:contentDescription="@string/play"
                    android:src="@drawable/ic_control_play" />

                <ImageView
                    android:id="@+id/next"
                    style="@style/Control.VodIcon.Action"
                    android:contentDescription="@string/play_next"
                    android:src="@drawable/ic_control_next"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <include
                android:id="@+id/action"
                layout="@layout/view_control_vod_action"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />

        </LinearLayout>

    </LinearLayout>
</RelativeLayout>
