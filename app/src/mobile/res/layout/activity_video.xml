<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:tag="port">

    <FrameLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true">

        <androidx.media3.ui.PlayerView
            android:id="@+id/exo"
            style="@style/Player.Vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:surface_type="surface_view" />

        <master.flame.danmaku.ui.widget.DanmakuView
            android:id="@+id/danmaku"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!--
            投屏占位层：投屏中本地播放器是停着的（不然手机和电视会同时拉一份流），
            画面区换成这块提示，下方的控制条改去操控电视。它必须排在 widget 之前——
            投屏时同样能滑动调进度、双击快进，那些提示要盖在这层上面才看得见；
            也排在 control 之前，控制层弹出来时仍然盖在它上面。
        -->
        <LinearLayout
            android:id="@+id/castOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cast_exit"
                android:src="@drawable/ic_control_cast"
                android:tint="@color/white" />

            <TextView
                android:id="@+id/castTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="正在投屏到 客厅电视" />

            <TextView
                android:id="@+id/castTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/cast_overlay_tip"
                android:textColor="@color/white_60"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/castExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/shape_detail_back"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="@string/cast_exit"
                android:textColor="@color/white"
                android:textSize="13sp" />

        </LinearLayout>

        <include
            android:id="@+id/widget"
            layout="@layout/view_widget_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/control"
            layout="@layout/view_control_vod"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!--
        悬浮返回键放在根布局而不是 video 里：video 挂了 OnTouchListener 处理播放手势，
        放在里面点击会被当成"单击播放区"。放到根布局同层且排在 video 之后，既在最上层
        又不经过播放手势那条链路。竖屏常驻，控制层显示时由 VideoActivity 去掉圆形底。
    -->
    <ImageView
        android:id="@+id/detail_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/shape_detail_back"
        android:clickable="true"
        android:contentDescription="@string/back"
        android:focusable="true"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/video">

        <com.fongmi.android.tv.ui.custom.ProgressLayout
            android:id="@+id/progressLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_detail_sheet">

            <com.fongmi.android.tv.ui.custom.DragSheetLayout
                android:id="@+id/handle"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/handle_bar"
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/shape_detail_handle" />

                    <!-- 标题 + 豆瓣评分（评分暂无数据源，默认隐藏） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:text="长夜迷城" />

                        <LinearLayout
                            android:id="@+id/rating_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="9.2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="2dp"
                                android:gravity="center_vertical"
                                android:text="@string/detail_rating"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                app:drawableEndCompat="@drawable/ic_detail_chevron"
                                app:drawableTint="@color/text_secondary" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- 年份 · 地区 · 集数 · 站点 -->
                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="16dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="2024 · 中国大陆 · 12集 · 站点：瓜子" />

                    <!-- 类型标签，由 VideoActivity 动态填充 -->
                    <HorizontalScrollView
                        android:id="@+id/tag_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:scrollbars="none"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:id="@+id/tags"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                    <!-- 演职人员：导演 + 演员合并成一段。展开按钮压在最后一行末端，背景同卡片底色用来盖住被截断的文字 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="16dp">

                        <TextView
                            android:id="@+id/cast_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:lineSpacingExtra="3dp"
                            android:maxLines="2"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            tools:text="演职人员：李昂（导演） / 曲云 / 袁霞 / 王志刚" />

                        <TextView
                            android:id="@+id/cast_expand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:background="@color/surface_primary"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:text="@string/detail_expand"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone"
                            app:drawableEndCompat="@drawable/ic_detail_expand"
                            app:drawableTint="@color/text_secondary"
                            tools:visibility="visible" />

                    </FrameLayout>

                    <!-- 播放线路 -->
                    <TextView
                        android:id="@+id/flag_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/detail_flag"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/flag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:scrollbars="none"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <!-- 画质 -->
                    <TextView
                        android:id="@+id/quality_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/detail_quality"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/quality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:scrollbars="none"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:visibility="visible" />

                    <!-- 剧集 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_episode"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/reverse"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_detail_reverse_plain"
                            android:tint="@color/text_secondary"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/download"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:drawablePadding="3dp"
                            android:gravity="center_vertical"
                            android:text="@string/download_entry"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_detail_download"
                            app:drawableTint="@color/text_secondary"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/more"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical"
                            android:text="@string/detail_more"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone"
                            app:drawableEndCompat="@drawable/ic_detail_chevron"
                            app:drawableTint="@color/text_secondary"
                            tools:visibility="visible" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/episode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:scrollbars="none"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <!-- 简介 -->
                    <LinearLayout
                        android:id="@+id/content_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginEnd="16dp"
                            android:text="@string/detail_content"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="16dp">

                            <TextView
                                android:id="@+id/content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:lineSpacingExtra="4dp"
                                android:maxLines="3"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                tools:text="雨夜，一桩离奇命案打破了平静的海滨小城。" />

                            <TextView
                                android:id="@+id/content_expand"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:background="@color/surface_primary"
                                android:drawablePadding="2dp"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:text="@string/detail_expand"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:visibility="gone"
                                app:drawableEndCompat="@drawable/ic_detail_expand"
                                app:drawableTint="@color/text_secondary"
                                tools:visibility="visible" />

                        </FrameLayout>

                    </LinearLayout>

                    <!-- 其他站点资源 -->
                    <TextView
                        android:id="@+id/quick_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/detail_quick"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/quick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:scrollbars="none"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/adapter_quick"
                        tools:visibility="visible" />


                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            </com.fongmi.android.tv.ui.custom.DragSheetLayout>
        </com.fongmi.android.tv.ui.custom.ProgressLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 横屏时压在详情卡片左边缘的竖把手，往右拖进入全屏 -->
    <FrameLayout
        android:id="@+id/handle_land"
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:layout_alignStart="@+id/swipeLayout"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="4dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_detail_handle" />

    </FrameLayout>

</RelativeLayout>
