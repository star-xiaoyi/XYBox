<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/rank_header"
                android:layout_width="match_parent"
                android:layout_height="280dp">

                <ImageView
                    android:id="@+id/rank_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_rank_hero_overlay" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="48dp">

                    <TextView
                        android:id="@+id/rank_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:maxLines="1"
                        android:textColor="@android:color/white"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="电视剧热播榜" />

                    <TextView
                        android:id="@+id/rank_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="start"
                        android:text="@string/recommend_rank_subtitle"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp" />

                </LinearLayout>

            </FrameLayout>

            <com.fongmi.android.tv.ui.custom.RankFilterView
                android:id="@+id/rank_tabs"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="-24dp"
                android:background="@drawable/shape_rank_filter_surface"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                android:paddingBottom="28dp" />

        </LinearLayout>

    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    <com.fongmi.android.tv.ui.custom.SecondaryGlassToolbarView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:outlineProvider="none" />

</FrameLayout>
