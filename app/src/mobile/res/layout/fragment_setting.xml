<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/screen_background"
        android:elevation="0dp"
        app:elevation="0dp"
        app:liftOnScrollColor="@color/screen_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <com.fongmi.android.tv.ui.custom.MarqueeLayout
                android:id="@+id/marquee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout style="@style/SettingsCard">

                <LinearLayout
                    android:id="@+id/vod"
                    style="@style/SettingsRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_vod" />

                        <TextView
                            android:id="@+id/vodUrl"
                            style="@style/SettingsSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="https://example.com/config.json" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/vodHome"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/shape_settings_icon"
                        android:contentDescription="@string/setting_choose"
                        android:padding="9dp"
                        android:src="@drawable/ic_setting_home"
                        android:tint="@color/text_secondary" />

                    <ImageView
                        android:id="@+id/vodHistory"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/shape_settings_icon"
                        android:contentDescription="@string/search_record"
                        android:padding="9dp"
                        android:src="@drawable/ic_setting_history"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/liveContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="64dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/separator" />

                    <LinearLayout
                        android:id="@+id/live"
                        style="@style/SettingsRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_live" />

                            <TextView
                                android:id="@+id/liveUrl"
                                style="@style/SettingsSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="https://example.com/live.m3u" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/liveHome"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/shape_settings_icon"
                            android:contentDescription="@string/setting_choose"
                            android:padding="9dp"
                            android:src="@drawable/ic_setting_home"
                            android:tint="@color/text_secondary" />

                        <ImageView
                            android:id="@+id/liveHistory"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/shape_settings_icon"
                            android:contentDescription="@string/search_record"
                            android:padding="9dp"
                            android:src="@drawable/ic_setting_history"
                            android:tint="@color/text_secondary" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/SettingsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                android:text="@string/setting_source_tip" />

            <LinearLayout
                style="@style/SettingsCard"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:id="@+id/theme"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_theme" />

                    <TextView
                        android:id="@+id/themeText"
                        style="@style/SettingsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="跟随系统" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/accent"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_accent" />

                    <View
                        android:id="@+id/accentPreview"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/shape_accent_preview" />

                    <TextView
                        android:id="@+id/accentText"
                        style="@style/SettingsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="黄色" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/size"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_size" />

                    <TextView
                        android:id="@+id/sizeText"
                        style="@style/SettingsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="中" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/historyVisible"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_history_visible" />

                    <com.fongmi.android.tv.ui.custom.CustomSwitch
                        android:id="@+id/historyVisibleSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/liveTabVisible"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_live_tab_visible" />

                    <com.fongmi.android.tv.ui.custom.CustomSwitch
                        android:id="@+id/liveTabVisibleSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                style="@style/SettingsCard"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:id="@+id/player"
                    style="@style/SettingsRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_player" />

                        <TextView
                            style="@style/SettingsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/setting_player_summary" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <!-- 操作设置入口（紧跟播放设置，进入二级页面） -->
                <LinearLayout
                    android:id="@+id/operation"
                    style="@style/SettingsRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_operation" />

                        <TextView
                            style="@style/SettingsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/setting_operation_summary" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/incognito"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_incognito" />

                    <com.fongmi.android.tv.ui.custom.CustomSwitch
                        android:id="@+id/incognitoSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                style="@style/SettingsCard"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:id="@+id/webdav"
                    style="@style/SettingsRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_webdav" />

                        <TextView
                            style="@style/SettingsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/setting_webdav_summary" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/syncSettings"
                    style="@style/SettingsRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_lan_sync" />

                        <TextView
                            style="@style/SettingsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/setting_lan_sync_summary" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/doh"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_doh" />

                    <TextView
                        android:id="@+id/dohText"
                        style="@style/SettingsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Cloudflare" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/proxy"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_proxy" />

                    <TextView
                        android:id="@+id/proxyText"
                        style="@style/SettingsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="无" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                style="@style/SettingsCard"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:id="@+id/cache"
                    style="@style/SettingsRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_cache" />

                        <TextView
                            style="@style/SettingsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_cache_summary" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/cacheText"
                        style="@style/SettingsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        tools:text="1.0 MB" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/backup"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_backup" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/restore"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_restore" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/version"
                    style="@style/SettingsRow">

                    <TextView
                        android:id="@+id/versionText"
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_version"
                        tools:text="版本 3.1.6" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/about"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_about" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="@color/text_secondary" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
