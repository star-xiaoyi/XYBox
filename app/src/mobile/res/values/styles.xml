<resources>

    <style name="AppTheme" parent="BaseTheme">
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="AppTheme.Live" parent="AppTheme">
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="AppTheme.Detail" parent="AppTheme">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="BaseTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorSurfaceVariant">@color/surface_secondary</item>
        <!--
            Material 1.12 的对话框/菜单/输入框背景走 surfaceContainer 系列，
            不映射的话会退回 M3 基线紫（浅色下就是那层淡紫，文字可见度很低）。
        -->
        <item name="colorSurfaceContainerLowest">@color/surface_primary</item>
        <item name="colorSurfaceContainerLow">@color/surface_primary</item>
        <item name="colorSurfaceContainer">@color/surface_primary</item>
        <item name="colorSurfaceContainerHigh">@color/surface_primary</item>
        <item name="colorSurfaceContainerHighest">@color/surface_secondary</item>
        <item name="colorSurfaceDim">@color/screen_background</item>
        <item name="colorSurfaceBright">@color/surface_primary</item>
        <!-- 抬升着色默认取 colorPrimary，主题色一换弹窗/卡片就整片染色，这里钉死为中性面 -->
        <item name="elevationOverlayColor">@color/surface_primary</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/separator</item>
        <item name="colorOutlineVariant">@color/separator</item>
        <item name="colorControlHighlight">@color/separator</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialog</item>
        <item name="bottomNavigationStyle">@style/BottomNavigation</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <!-- AlertDialog 按钮颜色 -->
        <item name="materialAlertDialogTheme">@style/MaterialAlertDialog</item>
    </style>

    <style name="Control" />

    <style name="Control.Action">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/shape_action_background</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <!-- 不在这里写死强调色：写死会盖掉 Activity 上的 accent 叠加层，弹窗里的胶囊/按钮就变成
             和设置里选的主题色无关的颜色。真正的颜色由下面四个子样式给，BaseDialog 按当前强调色挑一个 -->
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/ModalBottomSheetDialog</item>
    </style>

    <style name="BottomSheetDialog.Yellow">
        <item name="colorPrimary">@color/accent_yellow</item>
        <item name="colorPrimaryDark">@color/accent_yellow</item>
        <item name="colorSecondary">@color/accent_yellow</item>
        <item name="colorAccent">@color/accent_yellow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorControlActivated">@color/accent_yellow</item>
    </style>

    <style name="BottomSheetDialog.Blue">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorControlActivated">@color/accent_blue</item>
    </style>

    <style name="BottomSheetDialog.Green">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryDark">@color/accent_green</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorControlActivated">@color/accent_green</item>
    </style>

    <style name="BottomSheetDialog.Purple">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorPrimaryDark">@color/accent_purple</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorAccent">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorControlActivated">@color/accent_purple</item>
    </style>

    <style name="ModalBottomSheetDialog" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
        <!-- Material3 默认取 colorSurfaceContainerLow，浅色下是灰的，这里钉死成详情卡片同款白 -->
        <item name="backgroundTint">@color/surface_primary</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- 悬浮按钮做成正圆 -->
    <style name="ShapeAppearance.App.Fab" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimary</item>
        <item name="android:height">42dp</item>
    </style>
    
    <style name="BottomNavigationView.TextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    
    <style name="BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemPaddingTop">4dp</item>
        <item name="itemPaddingBottom">4dp</item>
        <item name="itemTextAppearanceActive">@style/BottomNavigationView.TextAppearance</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationView.TextAppearance</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="android:background">@null</item>
    </style>

    <style name="ThemeOverlay.XYBox.Accent" parent="ThemeOverlay.Material3" />

    <style name="ThemeOverlay.XYBox.Accent.Yellow">
        <item name="colorPrimary">@color/accent_yellow</item>
        <item name="colorPrimaryDark">@color/accent_yellow</item>
        <item name="colorSecondary">@color/accent_yellow</item>
        <item name="colorAccent">@color/accent_yellow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorControlActivated">@color/accent_yellow</item>
    </style>

    <style name="ThemeOverlay.XYBox.Accent.Blue">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorControlActivated">@color/accent_blue</item>
    </style>

    <style name="ThemeOverlay.XYBox.Accent.Green">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryDark">@color/accent_green</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorControlActivated">@color/accent_green</item>
    </style>

    <style name="ThemeOverlay.XYBox.Accent.Purple">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorPrimaryDark">@color/accent_purple</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorAccent">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorControlActivated">@color/accent_purple</item>
    </style>

    <style name="SettingsSectionTitle" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/shape_settings_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/shape_settings_row</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="SettingsTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsSummary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsValue" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- M3 Switch Style (Material Design) - 使用CustomSwitch完全自定义 -->
    <style name="M3SwitchStyle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/custom_switch_bg</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:minWidth">50dp</item>
    </style>
    
    <!-- 自定义数据源按钮样式 -->
    <style name="Widget.App.Button.OutlinedButton.SiteDialog" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconPadding">8dp</item>
        <item name="android:gravity">center</item>
        <item name="iconGravity">textStart</item>
        <item name="strokeColor">@color/white_10</item>
    </style>
    
    <!-- 自定义TextInputLayout样式 -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.TextInputLayout</item>
    </style>
    
    <style name="ShapeAppearance.App.TextInputLayout" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- MaterialAlertDialog 样式 -->
    <style name="MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- 弹窗底色固定为中性面，只有按钮和强调文字跟随主题色 -->
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorSurfaceContainerHigh">@color/surface_primary</item>
        <item name="colorSurfaceContainerHighest">@color/surface_secondary</item>
        <item name="colorSurfaceVariant">@color/surface_secondary</item>
        <item name="elevationOverlayColor">@color/surface_primary</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/separator</item>
        <item name="colorOutlineVariant">@color/separator</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertDialogButton</item>
    </style>

    <style name="AlertDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- 自绘弹窗底部的文字按钮 -->
    <style name="DialogTextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>
